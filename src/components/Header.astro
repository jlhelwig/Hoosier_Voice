---
const path = Astro.url.pathname;
const onArticles = path.startsWith('/articles');
---
<header class="border-b border-[var(--color-rule)]">
  <div class="max-w-3xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="font-mono font-semibold tracking-tight text-base">
      jeff helwig
    </a>
    <nav class="flex gap-6 text-sm">
      <a
        href="/articles/"
        class={onArticles ? 'underline underline-offset-4 decoration-1' : 'hover:underline underline-offset-4 decoration-1'}
      >
        articles
      </a>
    </nav>
  </div>
</header>
