---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('articles', ({ data }) => !data.draft);
const articles = all.sort(
  (a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)
);
---
<BaseLayout
  title="Articles"
  description="Writing on AI-assisted coding, product, and the work in between."
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-mono text-2xl font-semibold tracking-tight mb-8">articles</h1>
    {
      articles.length === 0 ? (
        <p class="muted">Drafts in progress. Nothing published yet.</p>
      ) : (
        <ul class="space-y-6">
          {articles.map((article) => (
            <li>
              <a href={`/articles/${article.id}/`} class="block group">
                <div class="font-medium text-lg group-hover:underline underline-offset-2">
                  {article.data.title}
                </div>
                {article.data.description && (
                  <p class="muted mt-1 text-base">{article.data.description}</p>
                )}
                {article.data.pubDate && (
                  <div class="muted text-sm mt-1 font-mono">
                    {article.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
