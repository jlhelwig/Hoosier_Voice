---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <h1 class="font-mono text-3xl font-semibold tracking-tight mb-3 leading-tight">
        {article.data.title}
      </h1>
      <div class="flex gap-3 muted text-sm font-mono">
        {
          article.data.pubDate && (
            <span>
              {article.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
          )
        }
        {article.data.draft && <span>· draft</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
